node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Secrets: never commit API keys
.env*
!.env.example
gemini_key*.txt*

# Raw TTS output cache (regenerable from voiceover/*.json)
voiceover/.cache/

# Episode renders (regenerable with npm/remotion; delivered from the episode folder)
Poor vs Rich Daily/episodes/**/*.mp4
Style Library/**/*.mp4

# Pixabay SFX: licensed for use in videos, not for redistribution as files
public/sfx/**/*.mp3

# third-party repos cloned for study (see reference/README.md, not committed)
reference/*
!reference/README.md

# reference videos downloaded for analysis (third-party, not ours)
Test/*.mp4

# Map project: third-party reference videos + Production Engine zip (study only), and our renders
Map/*.mp4
Map/*.zip
Map/**/*.mp4
# frames + transcripts cut from third-party videos for analysis (study only; our findings are in the .md reports)
Map/phan-tich/*.jpg
Map/phan-tich-doi-thu/_work/

# Mapped Journeys episode renders (regenerable; delivered from the episode folder)
Mapped Journeys/episodes/**/*.mp4

# episode-folder vo.mp3 is a local listening copy of public/voiceover/<slug>/vo.mp3 (tracked there)
Map/**/vo.mp3
Poor vs Rich Daily/episodes/**/vo.mp3

# third-party reference videos + captions for study (Lucas 2026-10-15): never commit
Test/**/*.mp4
Test/**/*_CAPTION.txt
# frames + transcripts cut from third-party videos for analysis (study only; findings are in the .md reports)
Test/doi-thu/_work/
