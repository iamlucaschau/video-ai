{
  "name": "don-johnson",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 75.149,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.3,
      "text": "You run a casino, and your biggest customer wants a discount on every dollar he loses.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/01.wav",
      "durationInSeconds": 4.215,
      "tempo": 1.02,
      "hash": "cb5f20b86228"
    },
    {
      "id": "02",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "It's late twenty ten in Atlantic City.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/02.wav",
      "durationInSeconds": 2.238,
      "tempo": 1.02,
      "hash": "c750b1fa0a54"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "The recession has thinned out the high rollers.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/03.wav",
      "durationInSeconds": 2.187,
      "tempo": 1.02,
      "hash": "c750b1fa0a54"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "One whale's night can decide whether a casino's month ends in the red.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/04.wav",
      "durationInSeconds": 3.195,
      "tempo": 1.02,
      "hash": "c750b1fa0a54"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.3,
      "text": "So the casinos start fighting for whales with discounts.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/05.wav",
      "durationInSeconds": 2.524,
      "tempo": 1.02,
      "hash": "c750b1fa0a54"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "Don Johnson used to run a racetrack.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/06.wav",
      "durationInSeconds": 1.607,
      "tempo": 1.02,
      "hash": "980172a12017"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "He started at twenty-five dollar tables.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/07.wav",
      "durationInSeconds": 1.999,
      "tempo": 1.02,
      "hash": "980172a12017"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "Now he bets a hundred thousand a hand.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/08.wav",
      "durationInSeconds": 2.33,
      "tempo": 1.02,
      "hash": "980172a12017"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.3,
      "text": "And he won't play until the casino agrees to his terms.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/09.wav",
      "durationInSeconds": 2.453,
      "tempo": 1.02,
      "hash": "980172a12017"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.12,
      "text": "Six decks.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/10.wav",
      "durationInSeconds": 0.936,
      "tempo": 1.02,
      "hash": "c3697a95d9e1"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.12,
      "text": "The dealer stands on soft seventeen.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/11.wav",
      "durationInSeconds": 1.679,
      "tempo": 1.02,
      "hash": "c3697a95d9e1"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.12,
      "text": "He can split aces again.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/12.wav",
      "durationInSeconds": 1.48,
      "tempo": 1.02,
      "hash": "c3697a95d9e1"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.3,
      "text": "Rule by rule, the house edge shrinks to about a quarter of one percent.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/13.wav",
      "durationInSeconds": 3.976,
      "tempo": 1.02,
      "hash": "c3697a95d9e1"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.12,
      "text": "Then the big one.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/14.wav",
      "durationInSeconds": 0.809,
      "tempo": 1.02,
      "hash": "91bb075fdf8d"
    },
    {
      "id": "15",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.8,
      "text": "Lose more than half a million, and the casino hands back twenty percent.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/15.wav",
      "durationInSeconds": 3.567,
      "tempo": 1.02,
      "hash": "91bb075fdf8d"
    },
    {
      "id": "16",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.12,
      "text": "Lose a million, and two hundred thousand comes back.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/16.wav",
      "durationInSeconds": 2.898,
      "tempo": 1.02,
      "hash": "91bb075fdf8d"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.12,
      "text": "His losing nights now cost less.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/17.wav",
      "durationInSeconds": 1.672,
      "tempo": 1.02,
      "hash": "91bb075fdf8d"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.3,
      "text": "His winning nights still pay in full.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/18.wav",
      "durationInSeconds": 1.622,
      "tempo": 1.02,
      "hash": "91bb075fdf8d"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "December, Caesars: about four point two million dollars.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/19.wav",
      "durationInSeconds": 3.254,
      "tempo": 1.02,
      "hash": "1da3040288df"
    },
    {
      "id": "20",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "Then the Borgata: about five million.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/20.wav",
      "durationInSeconds": 2.341,
      "tempo": 1.02,
      "hash": "1da3040288df"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "April, the Tropicana: five point eight million in twelve hours.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/21.wav",
      "durationInSeconds": 4.357,
      "tempo": 1.02,
      "hash": "1da3040288df"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "One hand alone paid eight hundred thousand.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/22.wav",
      "durationInSeconds": 2.756,
      "tempo": 1.02,
      "hash": "1da3040288df"
    },
    {
      "id": "23",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.3,
      "text": "It's the worst loss in the Tropicana's history.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/23.wav",
      "durationInSeconds": 1.93,
      "tempo": 1.02,
      "hash": "1da3040288df"
    },
    {
      "id": "24",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.12,
      "text": "That's about fifteen million in six months.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/24.wav",
      "durationInSeconds": 2.74,
      "tempo": 1.02,
      "hash": "72a5675bcfbc"
    },
    {
      "id": "25",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.12,
      "text": "Caesars bans him.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/25.wav",
      "durationInSeconds": 0.893,
      "tempo": 1.02,
      "hash": "72a5675bcfbc"
    },
    {
      "id": "26",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.3,
      "text": "Other casinos turn him away.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/26.wav",
      "durationInSeconds": 1.149,
      "tempo": 1.02,
      "hash": "72a5675bcfbc"
    },
    {
      "id": "27",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.12,
      "text": "So he must count cards, right?",
      "voice": "Charon",
      "src": "voiceover/don-johnson/27.wav",
      "durationInSeconds": 1.592,
      "tempo": 1.02,
      "hash": "fae8563bfa42"
    },
    {
      "id": "28",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.8,
      "text": "No.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/28.wav",
      "durationInSeconds": 0.294,
      "tempo": 1.02,
      "hash": "fae8563bfa42"
    },
    {
      "id": "29",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.12,
      "text": "He plays by the book, and luck still matters.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/29.wav",
      "durationInSeconds": 2.043,
      "tempo": 1.02,
      "hash": "fae8563bfa42"
    },
    {
      "id": "30",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.12,
      "text": "But the edge was never in his head.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/30.wav",
      "durationInSeconds": 1.927,
      "tempo": 1.02,
      "hash": "fae8563bfa42"
    },
    {
      "id": "31",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.8,
      "text": "The casinos wrote it into the deal themselves.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/31.wav",
      "durationInSeconds": 2.047,
      "tempo": 1.02,
      "hash": "fae8563bfa42"
    },
    {
      "id": "32",
      "scene": "s9",
      "take": "t09",
      "gapAfter": 0.12,
      "text": "The Tropicana and the Borgata stopped offering him those terms.",
      "voice": "Charon",
      "src": "voiceover/don-johnson/32.wav",
      "durationInSeconds": 2.707,
      "tempo": 1.02,
      "hash": "777cee8306dd"
    },
    {
      "id": "33",
      "scene": "s9",
      "take": "t09",
      "gapAfter": 0.3,
      "text": "So when a casino offers you a deal, who do you think did the math first?",
      "voice": "Charon",
      "src": "voiceover/don-johnson/33.wav",
      "durationInSeconds": 3.732,
      "tempo": 1.02,
      "hash": "777cee8306dd"
    }
  ]
}
