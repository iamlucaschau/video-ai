{
  "name": "f-microwave",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 52.905,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "In nineteen forty-five, a chocolate bar melted in an engineer's pocket.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/01.wav",
      "durationInSeconds": 4.714,
      "tempo": 1.1,
      "hash": "b383ff8d5ccf"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "Nobody had turned on a stove.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/02.wav",
      "durationInSeconds": 1.746,
      "tempo": 1.1,
      "hash": "b383ff8d5ccf"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "Percy Spencer was testing magnetrons, the tubes that powered wartime radar.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/03.wav",
      "durationInSeconds": 5.258,
      "tempo": 1.1,
      "hash": "9d7cbc1f67df"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "He guessed the invisible waves had cooked his snack.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/04.wav",
      "durationInSeconds": 2.734,
      "tempo": 1.1,
      "hash": "9d7cbc1f67df"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "So he held popcorn kernels up to the tube.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/05.wav",
      "durationInSeconds": 2.749,
      "tempo": 1.1,
      "hash": "9d7cbc1f67df"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "They popped all over the lab.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/06.wav",
      "durationInSeconds": 2.049,
      "tempo": 1.1,
      "hash": "9d7cbc1f67df"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "His company built the first microwave oven in nineteen forty-seven.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/07.wav",
      "durationInSeconds": 4.697,
      "tempo": 1.1,
      "hash": "77a674870359"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "It stood almost six feet tall and weighed about seven hundred fifty pounds.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/08.wav",
      "durationInSeconds": 5.681,
      "tempo": 1.1,
      "hash": "77a674870359"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.6,
      "text": "It went to restaurants and ships, not homes.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/09.wav",
      "durationInSeconds": 2.906,
      "tempo": 1.1,
      "hash": "77a674870359"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Twenty years later, a countertop model hit stores for four hundred ninety-five dollars.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/10.wav",
      "durationInSeconds": 6.194,
      "tempo": 1.1,
      "hash": "290db9ba7be7"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.6,
      "text": "Today, more than nine in ten American homes have one.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/11.wav",
      "durationInSeconds": 4.103,
      "tempo": 1.1,
      "hash": "290db9ba7be7"
    },
    {
      "id": "12",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "The waves make the water in food spin back and forth, and that motion becomes heat.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/12.wav",
      "durationInSeconds": 6.113,
      "tempo": 1.1,
      "hash": "20153cc315db"
    },
    {
      "id": "13",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Radar, pointed at dinner.",
      "voice": "Orus",
      "src": "voiceover/f-microwave/13.wav",
      "durationInSeconds": 1.658,
      "tempo": 1.1,
      "hash": "20153cc315db"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.6,
      "text": "And it all started because",
      "voice": "Orus",
      "src": "voiceover/f-microwave/14.wav",
      "durationInSeconds": 2.303,
      "tempo": 1.1,
      "hash": "20153cc315db"
    }
  ]
}
