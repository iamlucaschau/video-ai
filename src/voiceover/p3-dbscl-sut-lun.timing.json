{
  "durationInSeconds": 64.22954166666666,
  "loop": true,
  "tail": 0.7,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "start": 0.05,
      "end": 1.492,
      "text": "Ai cũng lo nước biển dâng."
    },
    {
      "id": "02",
      "scene": "s1",
      "start": 1.552375,
      "end": 4.210375,
      "text": "Nhưng miền Tây đang tự lún xuống, còn nhanh hơn thế."
    },
    {
      "id": "03",
      "scene": "s2",
      "start": 4.460541666666667,
      "end": 7.148541666666667,
      "text": "Đồng bằng sông Cửu Long là vựa lúa lớn nhất cả nước."
    },
    {
      "id": "04",
      "scene": "s2",
      "start": 7.20875,
      "end": 10.29775,
      "text": "Vậy mà trung bình, nó chỉ cao hơn mặt biển khoảng tám mươi phân."
    },
    {
      "id": "05",
      "scene": "s2",
      "start": 10.3575,
      "end": 11.7415,
      "text": "Chưa tới ngang hông một người lớn."
    },
    {
      "id": "06",
      "scene": "s3",
      "start": 11.991083333333334,
      "end": 16.097083333333334,
      "text": "Mà khoan, suốt mấy chục năm, nhiều nghiên cứu còn tưởng nó cao hơn hai mét rưỡi."
    },
    {
      "id": "07",
      "scene": "s3",
      "start": 16.157125,
      "end": 17.064125,
      "text": "Vì sao tính sai?"
    },
    {
      "id": "08",
      "scene": "s3",
      "start": 17.1245,
      "end": 21.0535,
      "text": "Vì mốc đo lấy theo mặt biển gần Hà Nội, cách đó gần hai nghìn cây số."
    },
    {
      "id": "09",
      "scene": "s4",
      "start": 21.303083333333333,
      "end": 23.040083333333335,
      "text": "Giờ đặt hai cây thước cạnh nhau."
    },
    {
      "id": "10",
      "scene": "s4",
      "start": 23.09975,
      "end": 25.73175,
      "text": "Nước biển toàn cầu dâng chưa tới bốn li mỗi năm."
    },
    {
      "id": "11",
      "scene": "s4",
      "start": 25.791458333333335,
      "end": 28.784458333333333,
      "text": "Đất miền Tây lún khoảng một phân, có nơi hơn hai phân rưỡi."
    },
    {
      "id": "12",
      "scene": "s4",
      "start": 28.844416666666667,
      "end": 30.077416666666668,
      "text": "Nhanh gấp khoảng ba lần."
    },
    {
      "id": "13",
      "scene": "s5",
      "start": 30.327625,
      "end": 33.380625,
      "text": "Thủ phạm số một nằm ngay dưới chân: nước ngầm."
    },
    {
      "id": "14",
      "scene": "s5",
      "start": 33.440916666666666,
      "end": 36.224916666666665,
      "text": "Bơm nước lên, các lớp đất bên dưới xẹp xuống."
    },
    {
      "id": "15",
      "scene": "s5",
      "start": 36.284958333333336,
      "end": 39.998958333333334,
      "text": "Hai mươi lăm năm, riêng chuyện này đã kéo đồng bằng xuống khoảng mười tám phân."
    },
    {
      "id": "16",
      "scene": "s6",
      "start": 40.249125,
      "end": 41.810125,
      "text": "Thủ phạm số hai: phù sa."
    },
    {
      "id": "17",
      "scene": "s6",
      "start": 41.87025,
      "end": 45.38225,
      "text": "Các đập trên dòng Mekong giữ lại một phần, cát dưới lòng sông thì bị hút đi."
    },
    {
      "id": "18",
      "scene": "s6",
      "start": 45.441874999999996,
      "end": 47.490874999999996,
      "text": "Phù sa về đồng bằng đã giảm khoảng một nửa."
    },
    {
      "id": "19",
      "scene": "s6",
      "start": 47.55045833333333,
      "end": 49.10945833333333,
      "text": "Đất lún mà không được bồi lại."
    },
    {
      "id": "20",
      "scene": "s7",
      "start": 49.35991666666666,
      "end": 52.14191666666666,
      "text": "Đồng bằng càng thấp, càng dễ bị nước mặn lấn vào."
    },
    {
      "id": "21",
      "scene": "s7",
      "start": 52.201874999999994,
      "end": 56.614875,
      "text": "Mùa khô năm hai nghìn mười sáu và hai nghìn hai mươi là những đợt hạn mặn lịch sử."
    },
    {
      "id": "22",
      "scene": "s8",
      "start": 56.865291666666664,
      "end": 63.97929166666666,
      "text": "Oái oăm ở chỗ: thứ kéo đồng bằng xuống nhiều nhất lại là nước ngọt ngay dưới chân, để uống, tưới ruộng, nuôi tôm cá."
    }
  ]
}
