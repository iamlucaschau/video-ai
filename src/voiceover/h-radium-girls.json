{
  "name": "h-radium-girls",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 53.096,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "They were told the glowing paint was safe enough to put in their mouths.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/01.wav",
      "durationInSeconds": 3.833,
      "tempo": 1.1,
      "hash": "4cb7b3a6f241"
    },
    {
      "id": "02",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "In nineteen seventeen, young women in New Jersey painted watch dials with radium, so soldiers could read the time in the dark.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/02.wav",
      "durationInSeconds": 8.158,
      "tempo": 1.1,
      "hash": "127084a92f1d"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "To keep a fine tip, they shaped each brush with their lips.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/03.wav",
      "durationInSeconds": 5.144,
      "tempo": 1.1,
      "hash": "127084a92f1d"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "Lip, dip, paint.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/04.wav",
      "durationInSeconds": 1.488,
      "tempo": 1.1,
      "hash": "127084a92f1d"
    },
    {
      "id": "05",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Radium settles in bone, like calcium.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/05.wav",
      "durationInSeconds": 3.632,
      "tempo": 1.1,
      "hash": "f5e63b000607"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Within a few years, some workers' jaws began to crumble.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/06.wav",
      "durationInSeconds": 3.875,
      "tempo": 1.1,
      "hash": "f5e63b000607"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.6,
      "text": "Some died.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/07.wav",
      "durationInSeconds": 0.787,
      "tempo": 1.1,
      "hash": "f5e63b000607"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "The company blamed other causes.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/08.wav",
      "durationInSeconds": 1.988,
      "tempo": 1.1,
      "hash": "3dc2d2a655e0"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.6,
      "text": "In nineteen twenty-five, a medical examiner tied the deaths to radium.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/09.wav",
      "durationInSeconds": 5.042,
      "tempo": 1.1,
      "hash": "3dc2d2a655e0"
    },
    {
      "id": "10",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "In nineteen twenty-seven, five of the women sued.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/10.wav",
      "durationInSeconds": 3.4,
      "tempo": 1.1,
      "hash": "7175e0e3af8b"
    },
    {
      "id": "11",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.6,
      "text": "They settled for ten thousand dollars each, and six hundred a year for life.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/11.wav",
      "durationInSeconds": 4.35,
      "tempo": 1.1,
      "hash": "7175e0e3af8b"
    },
    {
      "id": "12",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Their bones became the data behind the first radiation safety limits.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/12.wav",
      "durationInSeconds": 4.789,
      "tempo": 1.1,
      "hash": "1f40d5c28e23"
    },
    {
      "id": "13",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "Limits that later protected the workers of the atomic age.",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/13.wav",
      "durationInSeconds": 3.471,
      "tempo": 1.1,
      "hash": "1f40d5c28e23"
    },
    {
      "id": "14",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.6,
      "text": "They exist because, a century ago,",
      "voice": "Orus",
      "src": "voiceover/h-radium-girls/14.wav",
      "durationInSeconds": 3.139,
      "tempo": 1.1,
      "hash": "1f40d5c28e23"
    }
  ]
}
