{
  "name": "magellan",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 117.409,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Why did Magellan's shortcut to the Spice Islands take three years, when he thought the Pacific was a few days wide?",
      "voice": "Charon",
      "src": "voiceover/magellan/01.wav",
      "durationInSeconds": 6.759,
      "tempo": 1.05,
      "hash": "41fa349e3160"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.4,
      "text": "The answer is on this route, and in a map that made the world too small.",
      "voice": "Charon",
      "src": "voiceover/magellan/02.wav",
      "durationInSeconds": 4.902,
      "tempo": 1.05,
      "hash": "41fa349e3160"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "Spain, 1519.",
      "voice": "Charon",
      "src": "voiceover/magellan/03.wav",
      "durationInSeconds": 1.985,
      "tempo": 1.05,
      "hash": "8a03fcd83609"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Five ships sail for the Spice Islands.",
      "voice": "Charon",
      "src": "voiceover/magellan/04.wav",
      "durationInSeconds": 2.696,
      "tempo": 1.05,
      "hash": "8a03fcd83609"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "About two hundred and seventy men are aboard.",
      "voice": "Charon",
      "src": "voiceover/magellan/05.wav",
      "durationInSeconds": 2.223,
      "tempo": 1.05,
      "hash": "8a03fcd83609"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "They carry food for two years.",
      "voice": "Charon",
      "src": "voiceover/magellan/06.wav",
      "durationInSeconds": 1.665,
      "tempo": 1.05,
      "hash": "8a03fcd83609"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "In Brazil they turn south, and a wide river mouth turns out not to be a strait.",
      "voice": "Charon",
      "src": "voiceover/magellan/07.wav",
      "durationInSeconds": 5.022,
      "tempo": 1.05,
      "hash": "8a03fcd83609"
    },
    {
      "id": "08",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Winter traps them in a cold bay at San Julián, for five months.",
      "voice": "Charon",
      "src": "voiceover/magellan/08.wav",
      "durationInSeconds": 4.231,
      "tempo": 1.05,
      "hash": "8a03fcd83609"
    },
    {
      "id": "09",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Three captains mutiny, and Magellan crushes it.",
      "voice": "Charon",
      "src": "voiceover/magellan/09.wav",
      "durationInSeconds": 2.724,
      "tempo": 1.05,
      "hash": "8a03fcd83609"
    },
    {
      "id": "10",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.4,
      "text": "A storm wrecks one of his ships.",
      "voice": "Charon",
      "src": "voiceover/magellan/10.wav",
      "durationInSeconds": 1.846,
      "tempo": 1.05,
      "hash": "8a03fcd83609"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Then, a hidden passage: thirty-eight days of cold, narrow channels.",
      "voice": "Charon",
      "src": "voiceover/magellan/11.wav",
      "durationInSeconds": 5.29,
      "tempo": 1.05,
      "hash": "da7f4d8ab4d9"
    },
    {
      "id": "12",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.4,
      "text": "One crew turns around and sails home.",
      "voice": "Charon",
      "src": "voiceover/magellan/12.wav",
      "durationInSeconds": 1.943,
      "tempo": 1.05,
      "hash": "da7f4d8ab4d9"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Magellan expected the next sea to take three or four days.",
      "voice": "Charon",
      "src": "voiceover/magellan/13.wav",
      "durationInSeconds": 3.78,
      "tempo": 1.05,
      "hash": "ede8d97274f7"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "He believed Asia lay just beyond America.",
      "voice": "Charon",
      "src": "voiceover/magellan/14.wav",
      "durationInSeconds": 2.43,
      "tempo": 1.05,
      "hash": "ede8d97274f7"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "And the short way east, around Africa, belonged to Portugal by treaty.",
      "voice": "Charon",
      "src": "voiceover/magellan/15.wav",
      "durationInSeconds": 4.25,
      "tempo": 1.05,
      "hash": "ede8d97274f7"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.5,
      "text": "So he sailed into the largest ocean on Earth.",
      "voice": "Charon",
      "src": "voiceover/magellan/16.wav",
      "durationInSeconds": 3.229,
      "tempo": 1.05,
      "hash": "ede8d97274f7"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Ninety-eight days without fresh food.",
      "voice": "Charon",
      "src": "voiceover/magellan/17.wav",
      "durationInSeconds": 3.177,
      "tempo": 1.05,
      "hash": "3a748190d01a"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "They ate biscuit turned to powder and full of worms.",
      "voice": "Charon",
      "src": "voiceover/magellan/18.wav",
      "durationInSeconds": 2.999,
      "tempo": 1.05,
      "hash": "3a748190d01a"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "They soaked the leather from the masts, grilled it, and ate it.",
      "voice": "Charon",
      "src": "voiceover/magellan/19.wav",
      "durationInSeconds": 3.801,
      "tempo": 1.05,
      "hash": "3a748190d01a"
    },
    {
      "id": "20",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Even rats were sold for money.",
      "voice": "Charon",
      "src": "voiceover/magellan/20.wav",
      "durationInSeconds": 1.8,
      "tempo": 1.05,
      "hash": "3a748190d01a"
    },
    {
      "id": "21",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 2,
      "text": "Nineteen men died before they saw land again.",
      "voice": "Charon",
      "src": "voiceover/magellan/21.wav",
      "durationInSeconds": 2.893,
      "tempo": 1.05,
      "hash": "3a748190d01a"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "Guam.",
      "voice": "Charon",
      "src": "voiceover/magellan/22.wav",
      "durationInSeconds": 0.639,
      "tempo": 1.05,
      "hash": "8dc7813fee51"
    },
    {
      "id": "23",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Then the Philippines.",
      "voice": "Charon",
      "src": "voiceover/magellan/23.wav",
      "durationInSeconds": 1.528,
      "tempo": 1.05,
      "hash": "8dc7813fee51"
    },
    {
      "id": "24",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "On Mactan, the chief Lapu-Lapu refused to submit.",
      "voice": "Charon",
      "src": "voiceover/magellan/24.wav",
      "durationInSeconds": 4.096,
      "tempo": 1.05,
      "hash": "8dc7813fee51"
    },
    {
      "id": "25",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Magellan landed with forty-nine men, and died in the shallows.",
      "voice": "Charon",
      "src": "voiceover/magellan/25.wav",
      "durationInSeconds": 4.425,
      "tempo": 1.05,
      "hash": "8dc7813fee51"
    },
    {
      "id": "26",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.4,
      "text": "With too few sailors left, the crew burned one of their own ships.",
      "voice": "Charon",
      "src": "voiceover/magellan/26.wav",
      "durationInSeconds": 4.152,
      "tempo": 1.05,
      "hash": "8dc7813fee51"
    },
    {
      "id": "27",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Six months later, they reached the Spice Islands, and filled the holds with cloves.",
      "voice": "Charon",
      "src": "voiceover/magellan/27.wav",
      "durationInSeconds": 4.642,
      "tempo": 1.05,
      "hash": "aec497ea2fd9"
    },
    {
      "id": "28",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "To get home, they had to sail through waters Portugal controlled.",
      "voice": "Charon",
      "src": "voiceover/magellan/28.wav",
      "durationInSeconds": 3.261,
      "tempo": 1.05,
      "hash": "aec497ea2fd9"
    },
    {
      "id": "29",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Around Africa, with only rice and water left, twenty-one more died.",
      "voice": "Charon",
      "src": "voiceover/magellan/29.wav",
      "durationInSeconds": 4.634,
      "tempo": 1.05,
      "hash": "aec497ea2fd9"
    },
    {
      "id": "30",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.12,
      "text": "At Cape Verde, they asked what day it was.",
      "voice": "Charon",
      "src": "voiceover/magellan/30.wav",
      "durationInSeconds": 2.152,
      "tempo": 1.05,
      "hash": "aec497ea2fd9"
    },
    {
      "id": "31",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Their logbook was one day behind.",
      "voice": "Charon",
      "src": "voiceover/magellan/31.wav",
      "durationInSeconds": 2.208,
      "tempo": 1.05,
      "hash": "aec497ea2fd9"
    },
    {
      "id": "32",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.4,
      "text": "They had sailed all the way around the world, the first to do it, and lost a day.",
      "voice": "Charon",
      "src": "voiceover/magellan/32.wav",
      "durationInSeconds": 5,
      "tempo": 1.05,
      "hash": "aec497ea2fd9"
    },
    {
      "id": "33",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "A few days became ninety-eight.",
      "voice": "Charon",
      "src": "voiceover/magellan/33.wav",
      "durationInSeconds": 2.17,
      "tempo": 1.05,
      "hash": "58fdae36dede"
    },
    {
      "id": "34",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "A shortcut became three years.",
      "voice": "Charon",
      "src": "voiceover/magellan/34.wav",
      "durationInSeconds": 2.62,
      "tempo": 1.05,
      "hash": "58fdae36dede"
    },
    {
      "id": "35",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Five ships became one, with eighteen men aboard.",
      "voice": "Charon",
      "src": "voiceover/magellan/35.wav",
      "durationInSeconds": 3.961,
      "tempo": 1.05,
      "hash": "58fdae36dede"
    },
    {
      "id": "36",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.4,
      "text": "And Magellan himself never came home.",
      "voice": "Charon",
      "src": "voiceover/magellan/36.wav",
      "durationInSeconds": 2.276,
      "tempo": 1.05,
      "hash": "58fdae36dede"
    }
  ]
}
