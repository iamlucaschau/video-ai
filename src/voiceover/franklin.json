{
  "name": "franklin",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 117.378,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.12,
      "text": "In 1845, two British ships sailed into the Arctic with food for three years.",
      "voice": "Charon",
      "src": "voiceover/franklin/01.wav",
      "durationInSeconds": 6.543,
      "tempo": 1,
      "hash": "83ae3fb09f79"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Why did it take 169 years to find them?",
      "voice": "Charon",
      "src": "voiceover/franklin/02.wav",
      "durationInSeconds": 3.637,
      "tempo": 1,
      "hash": "83ae3fb09f79"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.4,
      "text": "The answer is on this route, and in a note no one found for eleven years.",
      "voice": "Charon",
      "src": "voiceover/franklin/03.wav",
      "durationInSeconds": 6.035,
      "tempo": 1,
      "hash": "83ae3fb09f79"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Sir John Franklin had 129 men, steam engines, and orders to finish the Northwest Passage.",
      "voice": "Charon",
      "src": "voiceover/franklin/04.wav",
      "durationInSeconds": 7.01,
      "tempo": 1,
      "hash": "7639ecd4652e"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "In the summer of 1845, whalers saw the ships in Baffin Bay.",
      "voice": "Charon",
      "src": "voiceover/franklin/05.wav",
      "durationInSeconds": 4.472,
      "tempo": 1,
      "hash": "7639ecd4652e"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.4,
      "text": "No European saw them again.",
      "voice": "Charon",
      "src": "voiceover/franklin/06.wav",
      "durationInSeconds": 1.652,
      "tempo": 1,
      "hash": "7639ecd4652e"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "They spent their first winter in the harbour of Beechey Island.",
      "voice": "Charon",
      "src": "voiceover/franklin/07.wav",
      "durationInSeconds": 3.016,
      "tempo": 1,
      "hash": "4a3c7897fb99"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "Three men died there.",
      "voice": "Charon",
      "src": "voiceover/franklin/08.wav",
      "durationInSeconds": 1.182,
      "tempo": 1,
      "hash": "4a3c7897fb99"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.4,
      "text": "Searchers later found their graves, but no note saying where the ships went.",
      "voice": "Charon",
      "src": "voiceover/franklin/09.wav",
      "durationInSeconds": 3.708,
      "tempo": 1,
      "hash": "4a3c7897fb99"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "In 1846 they sailed south, and took the west side of King William Island.",
      "voice": "Charon",
      "src": "voiceover/franklin/10.wav",
      "durationInSeconds": 5.504,
      "tempo": 1,
      "hash": "93536739084a"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.12,
      "text": "It was the wrong side.",
      "voice": "Charon",
      "src": "voiceover/franklin/11.wav",
      "durationInSeconds": 1.12,
      "tempo": 1,
      "hash": "93536739084a"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "The ice there doesn't always melt in summer.",
      "voice": "Charon",
      "src": "voiceover/franklin/12.wav",
      "durationInSeconds": 2.153,
      "tempo": 1,
      "hash": "93536739084a"
    },
    {
      "id": "13",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "In September, the ice closed around both ships, and held them for nineteen months.",
      "voice": "Charon",
      "src": "voiceover/franklin/13.wav",
      "durationInSeconds": 5.554,
      "tempo": 1,
      "hash": "93536739084a"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.12,
      "text": "In May 1847, officers left a note on the shore.",
      "voice": "Charon",
      "src": "voiceover/franklin/14.wav",
      "durationInSeconds": 3.92,
      "tempo": 1,
      "hash": "93536739084a"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.5,
      "text": "It said: \"All well.\"",
      "voice": "Charon",
      "src": "voiceover/franklin/15.wav",
      "durationInSeconds": 1.447,
      "tempo": 1,
      "hash": "93536739084a"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.4,
      "text": "They were less than 150 kilometres from waters already on the map.",
      "voice": "Charon",
      "src": "voiceover/franklin/16.wav",
      "durationInSeconds": 3.621,
      "tempo": 1,
      "hash": "93536739084a"
    },
    {
      "id": "17",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "A year later, someone wrote around the edges of that same note.",
      "voice": "Charon",
      "src": "voiceover/franklin/17.wav",
      "durationInSeconds": 3.764,
      "tempo": 1,
      "hash": "6275c63a9f02"
    },
    {
      "id": "18",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Twenty-four men were dead, Franklin among them.",
      "voice": "Charon",
      "src": "voiceover/franklin/18.wav",
      "durationInSeconds": 2.895,
      "tempo": 1,
      "hash": "6275c63a9f02"
    },
    {
      "id": "19",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "The other 105 had left the ships, and would walk south.",
      "voice": "Charon",
      "src": "voiceover/franklin/19.wav",
      "durationInSeconds": 3.334,
      "tempo": 1,
      "hash": "6275c63a9f02"
    },
    {
      "id": "20",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 1,
      "text": "Then the note went back under the stones.",
      "voice": "Charon",
      "src": "voiceover/franklin/20.wav",
      "durationInSeconds": 2.33,
      "tempo": 1,
      "hash": "6275c63a9f02"
    },
    {
      "id": "21",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "And here is the twist.",
      "voice": "Charon",
      "src": "voiceover/franklin/21.wav",
      "durationInSeconds": 1.612,
      "tempo": 1,
      "hash": "de462a881c88"
    },
    {
      "id": "22",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "In 1854, Inuit told John Rae what they knew: men dragging a boat south, starving.",
      "voice": "Charon",
      "src": "voiceover/franklin/22.wav",
      "durationInSeconds": 6.912,
      "tempo": 1,
      "hash": "de462a881c88"
    },
    {
      "id": "23",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "In London, the story was attacked.",
      "voice": "Charon",
      "src": "voiceover/franklin/23.wav",
      "durationInSeconds": 2.324,
      "tempo": 1,
      "hash": "de462a881c88"
    },
    {
      "id": "24",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Charles Dickens himself wrote against it.",
      "voice": "Charon",
      "src": "voiceover/franklin/24.wav",
      "durationInSeconds": 2.104,
      "tempo": 1,
      "hash": "de462a881c88"
    },
    {
      "id": "25",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "One search ship, Resolute, was abandoned in the ice.",
      "voice": "Charon",
      "src": "voiceover/franklin/25.wav",
      "durationInSeconds": 3.141,
      "tempo": 1,
      "hash": "de462a881c88"
    },
    {
      "id": "26",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Its timber became the desk in the Oval Office.",
      "voice": "Charon",
      "src": "voiceover/franklin/26.wav",
      "durationInSeconds": 2.488,
      "tempo": 1,
      "hash": "de462a881c88"
    },
    {
      "id": "27",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "The note was found in 1859, under those stones.",
      "voice": "Charon",
      "src": "voiceover/franklin/27.wav",
      "durationInSeconds": 3.994,
      "tempo": 1,
      "hash": "de462a881c88"
    },
    {
      "id": "28",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.5,
      "text": "But the ships stayed lost.",
      "voice": "Charon",
      "src": "voiceover/franklin/28.wav",
      "durationInSeconds": 1.937,
      "tempo": 1,
      "hash": "de462a881c88"
    },
    {
      "id": "29",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "In 2014, Erebus was found in waters where Inuit stories had long said a big ship sank.",
      "voice": "Charon",
      "src": "voiceover/franklin/29.wav",
      "durationInSeconds": 6.412,
      "tempo": 1,
      "hash": "03140732ea79"
    },
    {
      "id": "30",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.12,
      "text": "Two years later, an Inuk hunter remembered a mast in the ice.",
      "voice": "Charon",
      "src": "voiceover/franklin/30.wav",
      "durationInSeconds": 3.665,
      "tempo": 1,
      "hash": "03140732ea79"
    },
    {
      "id": "31",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.4,
      "text": "Terror lay in that bay.",
      "voice": "Charon",
      "src": "voiceover/franklin/31.wav",
      "durationInSeconds": 1.674,
      "tempo": 1,
      "hash": "03140732ea79"
    },
    {
      "id": "32",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.12,
      "text": "Food for three years.",
      "voice": "Charon",
      "src": "voiceover/franklin/32.wav",
      "durationInSeconds": 1.8,
      "tempo": 1,
      "hash": "bab88165e198"
    },
    {
      "id": "33",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "A hundred and sixty-nine years to find them.",
      "voice": "Charon",
      "src": "voiceover/franklin/33.wav",
      "durationInSeconds": 2.459,
      "tempo": 1,
      "hash": "bab88165e198"
    },
    {
      "id": "34",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.4,
      "text": "The Inuit had been telling the story since 1854.",
      "voice": "Charon",
      "src": "voiceover/franklin/34.wav",
      "durationInSeconds": 3.959,
      "tempo": 1,
      "hash": "bab88165e198"
    }
  ]
}
