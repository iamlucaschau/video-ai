{
  "name": "xuanzang",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 112.936,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Why did the monk behind Journey to the West need seventeen years to bring books back from India, just beyond the Himalayas?",
      "voice": "Charon",
      "src": "voiceover/xuanzang/01.wav",
      "durationInSeconds": 7.066,
      "tempo": 1.05,
      "hash": "328f63e4e7dd"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.4,
      "text": "The answer is on this route, and in one emperor's ban.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/02.wav",
      "durationInSeconds": 3.443,
      "tempo": 1.05,
      "hash": "328f63e4e7dd"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "Chang'an, China's capital.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/03.wav",
      "durationInSeconds": 1.923,
      "tempo": 1.05,
      "hash": "10bf0f6d12be"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "A young monk, Xuanzang, wants the original Buddhist texts of India.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/04.wav",
      "durationInSeconds": 4.381,
      "tempo": 1.05,
      "hash": "10bf0f6d12be"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.12,
      "text": "But the emperor has closed the borders.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/05.wav",
      "durationInSeconds": 2.152,
      "tempo": 1.05,
      "hash": "10bf0f6d12be"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "No one may leave.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/06.wav",
      "durationInSeconds": 1.165,
      "tempo": 1.05,
      "hash": "10bf0f6d12be"
    },
    {
      "id": "07",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.4,
      "text": "So he slips past the frontier watchtowers at night.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/07.wav",
      "durationInSeconds": 3.006,
      "tempo": 1.05,
      "hash": "10bf0f6d12be"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "His guide turns back.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/08.wav",
      "durationInSeconds": 1.459,
      "tempo": 1.05,
      "hash": "c77ef015f0cd"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "He crosses the desert alone, on one old horse.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/09.wav",
      "durationInSeconds": 3.368,
      "tempo": 1.05,
      "hash": "c77ef015f0cd"
    },
    {
      "id": "10",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "His water bag slips from his hands.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/10.wav",
      "durationInSeconds": 2.068,
      "tempo": 1.05,
      "hash": "c77ef015f0cd"
    },
    {
      "id": "11",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.5,
      "text": "Four nights and five days, without a drop of water.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/11.wav",
      "durationInSeconds": 3.709,
      "tempo": 1.05,
      "hash": "c77ef015f0cd"
    },
    {
      "id": "12",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.12,
      "text": "He turns toward China, then stops.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/12.wav",
      "durationInSeconds": 2.851,
      "tempo": 1.05,
      "hash": "c77ef015f0cd"
    },
    {
      "id": "13",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.8,
      "text": "Better to die going west, he said, than to live by returning east.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/13.wav",
      "durationInSeconds": 4.588,
      "tempo": 1.05,
      "hash": "c77ef015f0cd"
    },
    {
      "id": "14",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "At Turpan, a king tries to keep him at his court.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/14.wav",
      "durationInSeconds": 2.818,
      "tempo": 1.05,
      "hash": "abc234594bfc"
    },
    {
      "id": "15",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Xuanzang refuses to eat for three days, until the king lets him go.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/15.wav",
      "durationInSeconds": 4.596,
      "tempo": 1.05,
      "hash": "abc234594bfc"
    },
    {
      "id": "16",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "The straight road south is blocked by the Himalayas, so he goes around them.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/16.wav",
      "durationInSeconds": 4.138,
      "tempo": 1.05,
      "hash": "abc234594bfc"
    },
    {
      "id": "17",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.12,
      "text": "Seven days over the glaciers of the Tian Shan.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/17.wav",
      "durationInSeconds": 3.109,
      "tempo": 1.05,
      "hash": "abc234594bfc"
    },
    {
      "id": "18",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "More than a dozen of his party die of cold and hunger.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/18.wav",
      "durationInSeconds": 3.66,
      "tempo": 1.05,
      "hash": "abc234594bfc"
    },
    {
      "id": "19",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.4,
      "text": "Then Samarkand, Bamiyan, and over the Hindu Kush into India.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/19.wav",
      "durationInSeconds": 4.902,
      "tempo": 1.05,
      "hash": "abc234594bfc"
    },
    {
      "id": "20",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.4,
      "text": "And here is the twist.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/20.wav",
      "durationInSeconds": 1.61,
      "tempo": 1.05,
      "hash": "52f4a3fc403e"
    },
    {
      "id": "21",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "He doesn't just collect the books and leave.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/21.wav",
      "durationInSeconds": 2.184,
      "tempo": 1.05,
      "hash": "52f4a3fc403e"
    },
    {
      "id": "22",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.4,
      "text": "He stays more than ten years, studying at Nalanda and travelling across India.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/22.wav",
      "durationInSeconds": 5.487,
      "tempo": 1.05,
      "hash": "52f4a3fc403e"
    },
    {
      "id": "23",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "Going home, his boat nearly sinks on the Indus.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/23.wav",
      "durationInSeconds": 3.298,
      "tempo": 1.05,
      "hash": "ddb602153bf8"
    },
    {
      "id": "24",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Fifty manuscripts are lost.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/24.wav",
      "durationInSeconds": 1.593,
      "tempo": 1.05,
      "hash": "ddb602153bf8"
    },
    {
      "id": "25",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "From Khotan he writes to the emperor: \"I have passed seventeen years.\"",
      "voice": "Charon",
      "src": "voiceover/xuanzang/25.wav",
      "durationInSeconds": 4.797,
      "tempo": 1.05,
      "hash": "ddb602153bf8"
    },
    {
      "id": "26",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "The emperor writes back, overjoyed.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/26.wav",
      "durationInSeconds": 1.871,
      "tempo": 1.05,
      "hash": "ddb602153bf8"
    },
    {
      "id": "27",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.12,
      "text": "He enters Chang'an with six hundred and fifty-seven books.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/27.wav",
      "durationInSeconds": 3.506,
      "tempo": 1.05,
      "hash": "ddb602153bf8"
    },
    {
      "id": "28",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.4,
      "text": "They fill twenty horses.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/28.wav",
      "durationInSeconds": 1.537,
      "tempo": 1.05,
      "hash": "ddb602153bf8"
    },
    {
      "id": "29",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.12,
      "text": "A pagoda was built to hold them.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/29.wav",
      "durationInSeconds": 1.791,
      "tempo": 1.05,
      "hash": "48d2ac959fa2"
    },
    {
      "id": "30",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "It still stands in Xi'an.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/30.wav",
      "durationInSeconds": 1.511,
      "tempo": 1.05,
      "hash": "48d2ac959fa2"
    },
    {
      "id": "31",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.4,
      "text": "Nine centuries later, his journey became a novel, Journey to the West, with the Monkey King at his side.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/31.wav",
      "durationInSeconds": 7.075,
      "tempo": 1.05,
      "hash": "48d2ac959fa2"
    },
    {
      "id": "32",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Twenty-five hundred kilometres became seventeen years.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/32.wav",
      "durationInSeconds": 4.115,
      "tempo": 1.05,
      "hash": "48023abeac40"
    },
    {
      "id": "33",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.12,
      "text": "He crossed the desert with one horse.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/33.wav",
      "durationInSeconds": 2.363,
      "tempo": 1.05,
      "hash": "48023abeac40"
    },
    {
      "id": "34",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "He came home with twenty.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/34.wav",
      "durationInSeconds": 1.602,
      "tempo": 1.05,
      "hash": "48023abeac40"
    },
    {
      "id": "35",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.4,
      "text": "The monk who fled the empire came home its hero.",
      "voice": "Charon",
      "src": "voiceover/xuanzang/35.wav",
      "durationInSeconds": 4.194,
      "tempo": 1.05,
      "hash": "48023abeac40"
    }
  ]
}
