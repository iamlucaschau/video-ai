    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Đi từ Lào Cai sang Hà Khẩu, đồng hồ nhảy một tiếng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/01.wav",
      "durationInSeconds": 3.025,
      "tempo": 1.1,
      "hash": "ea48471f0955"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Nhưng đi tiếp hơn ba nghìn cây số về phía tây, nó không nhảy thêm phút nào.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/02.wav",
      "durationInSeconds": 3.699,
      "tempo": 1.1,
      "hash": "ea48471f0955"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Nếu chia theo Mặt Trời, lãnh thổ Trung Quốc trải gần năm múi giờ.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/03.wav",
      "durationInSeconds": 3.347,
      "tempo": 1.1,
      "hash": "381ac5c30aa4"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Cứ mười lăm độ kinh, mặt trời mọc chậm hơn một tiếng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/04.wav",
      "durationInSeconds": 2.871,
      "tempo": 1.1,
      "hash": "381ac5c30aa4"
    },
    {
      "id": "05",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Vậy mà từ khoảng năm một nghìn chín trăm bốn mươi chín, cả nước dùng chung một chiếc đồng hồ: giờ Bắc Kinh.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/05.wav",
      "durationInSeconds": 5.208,
      "tempo": 1.1,
      "hash": "dd1bcb7994ae"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Đây là nước rộng nhất thế giới chỉ dùng một giờ.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/06.wav",
      "durationInSeconds": 2.417,
      "tempo": 1.1,
      "hash": "dd1bcb7994ae"
    },
    {
      "id": "07",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Hệ quả?",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/07.wav",
      "durationInSeconds": 0.843,
      "tempo": 1.1,
      "hash": "1e4c615c5c6f"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Ở Kashgar, cực tây Tân Cương, ngày đầu năm, gần mười giờ sáng mặt trời mới mọc.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/08.wav",
      "durationInSeconds": 4.851,
      "tempo": 1.1,
      "hash": "1e4c615c5c6f"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Cùng ngày ấy ở Bắc Kinh, mặt trời mọc từ khoảng bảy giờ rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/09.wav",
      "durationInSeconds": 2.99,
      "tempo": 1.1,
      "hash": "1e4c615c5c6f"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Mùa hè, hơn mười giờ tối trời mới tắt nắng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/10.wav",
      "durationInSeconds": 2.509,
      "tempo": 1.1,
      "hash": "1e4c615c5c6f"
    },
    {
      "id": "11",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Thử tưởng tượng: tám giờ sáng đi học, ngoài trời vẫn tối om.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/11.wav",
      "durationInSeconds": 3.247,
      "tempo": 1.1,
      "hash": "e2fbff2cb316"
    },
    {
      "id": "12",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Nên ở Tân Cương, nhiều người còn dùng thêm một giờ không chính thức, chậm hơn hai tiếng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/12.wav",
      "durationInSeconds": 4.583,
      "tempo": 1.1,
      "hash": "e8d5da2da396"
    },
    {
      "id": "13",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Đài truyền hình ở đây còn xếp lịch theo cả hai giờ.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/13.wav",
      "durationInSeconds": 2.78,
      "tempo": 1.1,
      "hash": "e8d5da2da396"
    },
    {
      "id": "14",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Một vùng đất, hai chiếc đồng hồ.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/14.wav",
      "durationInSeconds": 1.84,
      "tempo": 1.1,
      "hash": "e8d5da2da396"
    },
    {
      "id": "15",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Nhưng chỗ kỳ lạ nhất nằm ở biên giới với Afghanistan, nước dùng múi giờ lẻ nửa tiếng.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/15.wav",
      "durationInSeconds": 5.313,
      "tempo": 1.1,
      "hash": "36de8f7f7260"
    },
    {
      "id": "16",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Nếu bước qua được, đồng hồ lệch tới ba tiếng rưỡi, một trong những chỗ lệch giờ lớn nhất thế giới.",
      "voice": "Orus",
      "src": "voiceover/p5-trung-quoc-mui-gio/16.wav",
      "durationInSeconds": 5.768,
      "tempo": 1.1,
      "hash": "36de8f7f7260"
    },
    {
      "id": "17",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Chỉ có điều, ở đó chẳng có cửa khẩu nào để bước qua.",
