{
  "name": "g-round-windows",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 54.864,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.15,
      "text": "Every airliner window has rounded corners.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/01.wav",
      "durationInSeconds": 3.239,
      "tempo": 1.1,
      "hash": "f3791320d488"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.6,
      "text": "That is not for style.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/02.wav",
      "durationInSeconds": 1.817,
      "tempo": 1.1,
      "hash": "f3791320d488"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.15,
      "text": "In nineteen fifty-two, the de Havilland Comet became the first jet airliner to carry passengers.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/03.wav",
      "durationInSeconds": 6.147,
      "tempo": 1.1,
      "hash": "5b259eba1a3d"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.6,
      "text": "It flew high and fast, in a pressurized cabin.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/04.wav",
      "durationInSeconds": 3.066,
      "tempo": 1.1,
      "hash": "5b259eba1a3d"
    },
    {
      "id": "05",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.15,
      "text": "Then, in nineteen fifty-four, two Comets broke apart in the sky, three months apart.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/05.wav",
      "durationInSeconds": 6.79,
      "tempo": 1.1,
      "hash": "8610b595fbf9"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.6,
      "text": "Every Comet was grounded.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/06.wav",
      "durationInSeconds": 1.362,
      "tempo": 1.1,
      "hash": "8610b595fbf9"
    },
    {
      "id": "07",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "Engineers put a whole Comet in a giant water tank.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/07.wav",
      "durationInSeconds": 3.91,
      "tempo": 1.1,
      "hash": "49ec708e6e9d"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "They pumped the cabin up and down, flight after flight.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/08.wav",
      "durationInSeconds": 3.295,
      "tempo": 1.1,
      "hash": "49ec708e6e9d"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.15,
      "text": "After about three thousand flights' worth of pressure, the cabin split open.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/09.wav",
      "durationInSeconds": 5.546,
      "tempo": 1.1,
      "hash": "49ec708e6e9d"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.6,
      "text": "The crack started at a corner.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/10.wav",
      "durationInSeconds": 2.218,
      "tempo": 1.1,
      "hash": "49ec708e6e9d"
    },
    {
      "id": "11",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Every flight, the cabin swells like a balloon.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/11.wav",
      "durationInSeconds": 3.174,
      "tempo": 1.1,
      "hash": "387ce476cfe7"
    },
    {
      "id": "12",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "A sharp corner piles that stress into one tiny point.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/12.wav",
      "durationInSeconds": 3.687,
      "tempo": 1.1,
      "hash": "387ce476cfe7"
    },
    {
      "id": "13",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.15,
      "text": "Metal bent there again and again gets tired, and cracks.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/13.wav",
      "durationInSeconds": 4.107,
      "tempo": 1.1,
      "hash": "387ce476cfe7"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.6,
      "text": "Round corners spread the stress out.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/14.wav",
      "durationInSeconds": 2.488,
      "tempo": 1.1,
      "hash": "387ce476cfe7"
    },
    {
      "id": "15",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.15,
      "text": "So the corners were rounded.",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/15.wav",
      "durationInSeconds": 2.215,
      "tempo": 1.1,
      "hash": "03ca39cb4937"
    },
    {
      "id": "16",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.6,
      "text": "And that is why, to this day,",
      "voice": "Orus",
      "src": "voiceover/g-round-windows/16.wav",
      "durationInSeconds": 1.803,
      "tempo": 1.1,
      "hash": "03ca39cb4937"
    }
  ]
}
