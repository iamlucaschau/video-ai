{
  "name": "p2-duong-sat-cao-toc",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 66.717,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Việt Nam dự kiến chi khoảng sáu mươi bảy tỷ đô, chỉ để mua một ngày.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/01.wav",
      "durationInSeconds": 3.862,
      "tempo": 1,
      "hash": "ebde9b5414c3"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Nghe vô lý?",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/02.wav",
      "durationInSeconds": 1.124,
      "tempo": 1,
      "hash": "ebde9b5414c3"
    },
    {
      "id": "03",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Thử cho hai đoàn tàu cùng rời Hà Nội.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/03.wav",
      "durationInSeconds": 2.109,
      "tempo": 1,
      "hash": "ebde9b5414c3"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Tàu Thống Nhất hôm nay: lên tàu buổi tối, ngủ hai đêm, hơn ba mươi tiếng mới tới Sài Gòn.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/04.wav",
      "durationInSeconds": 5.206,
      "tempo": 1,
      "hash": "a5a34efc9532"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Tàu cao tốc nhanh nhất, chỉ dừng năm ga, dự kiến khoảng năm tiếng rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/05.wav",
      "durationInSeconds": 3.986,
      "tempo": 1,
      "hash": "a5a34efc9532"
    },
    {
      "id": "06",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Ăn sáng phở Hà Nội, ăn trưa cơm tấm Sài Gòn.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/06.wav",
      "durationInSeconds": 2.841,
      "tempo": 1,
      "hash": "a5a34efc9532"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Nhưng cái giá thì không hề nhẹ.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/07.wav",
      "durationInSeconds": 1.725,
      "tempo": 1,
      "hash": "764f3c544e84"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Tuyến dài khoảng một nghìn năm trăm bốn mươi mốt cây số.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/08.wav",
      "durationInSeconds": 2.72,
      "tempo": 1,
      "hash": "764f3c544e84"
    },
    {
      "id": "09",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Theo vốn sơ bộ, mỗi mét đường tốn hơn một tỷ đồng.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/09.wav",
      "durationInSeconds": 3.382,
      "tempo": 1,
      "hash": "764f3c544e84"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Vì sao đắt vậy?",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/10.wav",
      "durationInSeconds": 0.907,
      "tempo": 1,
      "hash": "4cedb6bacacc"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Để chạy ba trăm năm mươi cây số một giờ, tuyến dự kiến có khoảng sáu mươi phần trăm là cầu, mười phần trăm là hầm.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/11.wav",
      "durationInSeconds": 6.045,
      "tempo": 1,
      "hash": "4cedb6bacacc"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Phần lớn con đường được nhấc hẳn lên khỏi mặt đất.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/12.wav",
      "durationInSeconds": 2.217,
      "tempo": 1,
      "hash": "4cedb6bacacc"
    },
    {
      "id": "13",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Dù vậy, cuối năm hai nghìn hai mươi tư, Quốc hội vẫn bấm nút.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/13.wav",
      "durationInSeconds": 3.938,
      "tempo": 1,
      "hash": "bd7b4b411e8e"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Bốn trăm bốn mươi ba trên bốn trăm năm mươi tư đại biểu tán thành.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/14.wav",
      "durationInSeconds": 3.188,
      "tempo": 1,
      "hash": "bd7b4b411e8e"
    },
    {
      "id": "15",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Câu hỏi lớn nhất vẫn còn đó: bao giờ hoàn vốn?",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/15.wav",
      "durationInSeconds": 2.876,
      "tempo": 1,
      "hash": "413f36459f21"
    },
    {
      "id": "16",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Chính phủ thừa nhận, bốn năm đầu, doanh thu chỉ đủ bù chi phí vận hành.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/16.wav",
      "durationInSeconds": 4.62,
      "tempo": 1,
      "hash": "413f36459f21"
    },
    {
      "id": "17",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Phần bảo trì hạ tầng, Nhà nước vẫn phải lo.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/17.wav",
      "durationInSeconds": 2.58,
      "tempo": 1,
      "hash": "413f36459f21"
    },
    {
      "id": "18",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Giờ quay lại hai đoàn tàu.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/18.wav",
      "durationInSeconds": 1.439,
      "tempo": 1,
      "hash": "cd742fb4eb7a"
    },
    {
      "id": "19",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Khi tàu cao tốc đã tới Thủ Thiêm, tàu Thống Nhất còn chưa tới Vinh.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/19.wav",
      "durationInSeconds": 3.583,
      "tempo": 1,
      "hash": "cd742fb4eb7a"
    },
    {
      "id": "20",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Mà oái oăm ở chỗ: tuyến Thống Nhất được nối liền từ năm một nghìn chín trăm ba mươi sáu.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/20.wav",
      "durationInSeconds": 4.994,
      "tempo": 1,
      "hash": "1d9f522bc249"
    },
    {
      "id": "21",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Chín mươi năm sau, đi hết tuyến vẫn mất hơn một ngày.",
      "voice": "Orus",
      "src": "voiceover/p2-duong-sat-cao-toc/21.wav",
      "durationInSeconds": 3.375,
      "tempo": 1,
      "hash": "1d9f522bc249"
    }
  ]
}
