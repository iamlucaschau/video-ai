{
  "name": "p3-dbscl-sut-lun",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 61.944,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Ai cũng lo nước biển dâng.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/01.wav",
      "durationInSeconds": 1.442,
      "tempo": 1.1,
      "hash": "2e398f0572cb"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Nhưng miền Tây đang tự lún xuống, còn nhanh hơn thế.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/02.wav",
      "durationInSeconds": 2.658,
      "tempo": 1.1,
      "hash": "2e398f0572cb"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Đồng bằng sông Cửu Long là vựa lúa lớn nhất cả nước.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/03.wav",
      "durationInSeconds": 2.688,
      "tempo": 1.1,
      "hash": "1b07809e2c0f"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Vậy mà trung bình, nó chỉ cao hơn mặt biển khoảng tám mươi phân.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/04.wav",
      "durationInSeconds": 3.089,
      "tempo": 1.1,
      "hash": "1b07809e2c0f"
    },
    {
      "id": "05",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Chưa tới ngang hông một người lớn.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/05.wav",
      "durationInSeconds": 1.384,
      "tempo": 1.1,
      "hash": "1b07809e2c0f"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Mà khoan, suốt mấy chục năm, nhiều nghiên cứu còn tưởng nó cao hơn hai mét rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/06.wav",
      "durationInSeconds": 4.106,
      "tempo": 1.1,
      "hash": "c740a534a42f"
    },
    {
      "id": "07",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Vì sao tính sai?",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/07.wav",
      "durationInSeconds": 0.907,
      "tempo": 1.1,
      "hash": "c740a534a42f"
    },
    {
      "id": "08",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Vì mốc đo lấy theo mặt biển gần Hà Nội, cách đó gần hai nghìn cây số.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/08.wav",
      "durationInSeconds": 3.929,
      "tempo": 1.1,
      "hash": "c740a534a42f"
    },
    {
      "id": "09",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Giờ đặt hai cây thước cạnh nhau.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/09.wav",
      "durationInSeconds": 1.737,
      "tempo": 1.1,
      "hash": "8460130d26ba"
    },
    {
      "id": "10",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Nước biển toàn cầu dâng chưa tới bốn li mỗi năm.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/10.wav",
      "durationInSeconds": 2.632,
      "tempo": 1.1,
      "hash": "8460130d26ba"
    },
    {
      "id": "11",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Đất miền Tây lún khoảng một phân, có nơi hơn hai phân rưỡi.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/11.wav",
      "durationInSeconds": 2.993,
      "tempo": 1.1,
      "hash": "8460130d26ba"
    },
    {
      "id": "12",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Nhanh gấp khoảng ba lần.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/12.wav",
      "durationInSeconds": 1.233,
      "tempo": 1.1,
      "hash": "8460130d26ba"
    },
    {
      "id": "13",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Thủ phạm số một nằm ngay dưới chân: nước ngầm.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/13.wav",
      "durationInSeconds": 3.053,
      "tempo": 1.1,
      "hash": "9bd801c92e59"
    },
    {
      "id": "14",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Bơm nước lên, các lớp đất bên dưới xẹp xuống.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/14.wav",
      "durationInSeconds": 2.784,
      "tempo": 1.1,
      "hash": "9bd801c92e59"
    },
    {
      "id": "15",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Hai mươi lăm năm, riêng chuyện này đã kéo đồng bằng xuống khoảng mười tám phân.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/15.wav",
      "durationInSeconds": 3.714,
      "tempo": 1.1,
      "hash": "9bd801c92e59"
    },
    {
      "id": "16",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Thủ phạm số hai: phù sa.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/16.wav",
      "durationInSeconds": 1.561,
      "tempo": 1.1,
      "hash": "5e018289141f"
    },
    {
      "id": "17",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Các đập trên dòng Mekong giữ lại một phần, cát dưới lòng sông thì bị hút đi.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/17.wav",
      "durationInSeconds": 3.512,
      "tempo": 1.1,
      "hash": "5e018289141f"
    },
    {
      "id": "18",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Phù sa về đồng bằng đã giảm khoảng một nửa.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/18.wav",
      "durationInSeconds": 2.049,
      "tempo": 1.1,
      "hash": "5e018289141f"
    },
    {
      "id": "19",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Đất lún mà không được bồi lại.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/19.wav",
      "durationInSeconds": 1.559,
      "tempo": 1.1,
      "hash": "5e018289141f"
    },
    {
      "id": "20",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Đồng bằng càng thấp, càng dễ bị nước mặn lấn vào.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/20.wav",
      "durationInSeconds": 2.782,
      "tempo": 1.1,
      "hash": "a61ddb7f5943"
    },
    {
      "id": "21",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Mùa khô năm hai nghìn mười sáu và hai nghìn hai mươi là những đợt hạn mặn lịch sử.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/21.wav",
      "durationInSeconds": 4.413,
      "tempo": 1.1,
      "hash": "a61ddb7f5943"
    },
    {
      "id": "22",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Oái oăm ở chỗ: thứ kéo đồng bằng xuống nhiều nhất lại là nước ngọt ngay dưới chân, để uống, tưới ruộng, nuôi tôm cá.",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/22.wav",
      "durationInSeconds": 7.114,
      "tempo": 1.1,
      "hash": "f5632a601efb"
    },
    {
      "id": "23",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.25,
      "text": "Vậy mà",
      "voice": "Orus",
      "src": "voiceover/p3-dbscl-sut-lun/23.wav",
      "durationInSeconds": 0.605,
      "tempo": 1.1,
      "hash": "f5632a601efb"
    }
  ]
}
