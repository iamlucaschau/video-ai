{
  "name": "p4-malacca-kra",
  "model": "gemini-3.8-flash-tts",
  "totalSeconds": 62.006,
  "lines": [
    {
      "id": "01",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.06,
      "text": "Gần một phần ba lượng dầu chở bằng đường biển của thế giới phải chen qua một eo biển.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/01.wav",
      "durationInSeconds": 4.436,
      "tempo": 1.1,
      "hash": "18857b3ebc79"
    },
    {
      "id": "02",
      "scene": "s1",
      "take": "t01",
      "gapAfter": 0.25,
      "text": "Ngay phía trên có một lối tắt, mà gần ba trăm năm mươi năm nay chưa ai đào.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/02.wav",
      "durationInSeconds": 4.117,
      "tempo": 1.1,
      "hash": "18857b3ebc79"
    },
    {
      "id": "03",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.06,
      "text": "Thử theo một con tàu dầu từ Trung Đông sang Đông Á.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/03.wav",
      "durationInSeconds": 2.862,
      "tempo": 1.1,
      "hash": "e6579f753521"
    },
    {
      "id": "04",
      "scene": "s2",
      "take": "t02",
      "gapAfter": 0.25,
      "text": "Muốn vào Biển Đông, nó phải vòng xuống tận eo Malacca.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/04.wav",
      "durationInSeconds": 2.961,
      "tempo": 1.1,
      "hash": "e6579f753521"
    },
    {
      "id": "05",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn hai mươi lăm, hơn một trăm nghìn lượt tàu chen qua đây.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/05.wav",
      "durationInSeconds": 3.677,
      "tempo": 1.1,
      "hash": "f4fadb378b3b"
    },
    {
      "id": "06",
      "scene": "s3",
      "take": "t03",
      "gapAfter": 0.25,
      "text": "Chỗ hẹp nhất, gần Singapore, chỉ rộng khoảng hai, ba cây số.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/06.wav",
      "durationInSeconds": 3.718,
      "tempo": 1.1,
      "hash": "f4fadb378b3b"
    },
    {
      "id": "07",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.06,
      "text": "Trong khi đó, ở miền Nam Thái Lan, eo đất Kra chỉ rộng hơn bốn mươi cây số.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/07.wav",
      "durationInSeconds": 4.346,
      "tempo": 1.1,
      "hash": "2ddbe099e5c2"
    },
    {
      "id": "08",
      "scene": "s4",
      "take": "t04",
      "gapAfter": 0.25,
      "text": "Đào một con kênh ở đây, tàu khỏi phải vòng qua Singapore.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/08.wav",
      "durationInSeconds": 2.996,
      "tempo": 1.1,
      "hash": "2ddbe099e5c2"
    },
    {
      "id": "09",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.06,
      "text": "Ý tưởng này có từ năm một nghìn sáu trăm bảy mươi bảy, thời vua Narai.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/09.wav",
      "durationInSeconds": 3.609,
      "tempo": 1.1,
      "hash": "f316ba2b6899"
    },
    {
      "id": "10",
      "scene": "s5",
      "take": "t05",
      "gapAfter": 0.25,
      "text": "Bàn đi bàn lại mấy trăm năm, vẫn chưa đào một mét nào.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/10.wav",
      "durationInSeconds": 3.218,
      "tempo": 1.1,
      "hash": "f316ba2b6899"
    },
    {
      "id": "11",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Vì sao?",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/11.wav",
      "durationInSeconds": 0.766,
      "tempo": 1.1,
      "hash": "0308042e1e32"
    },
    {
      "id": "12",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Thứ nhất, tốn hàng chục tỷ đô.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/12.wav",
      "durationInSeconds": 1.809,
      "tempo": 1.1,
      "hash": "0308042e1e32"
    },
    {
      "id": "13",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.06,
      "text": "Thứ hai, lối tắt chỉ tiết kiệm khoảng một đến ba ngày đi biển.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/13.wav",
      "durationInSeconds": 3.115,
      "tempo": 1.1,
      "hash": "0308042e1e32"
    },
    {
      "id": "14",
      "scene": "s6",
      "take": "t06",
      "gapAfter": 0.25,
      "text": "Thứ ba, lo ngại về môi trường và an ninh.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/14.wav",
      "durationInSeconds": 2.338,
      "tempo": 1.1,
      "hash": "0308042e1e32"
    },
    {
      "id": "15",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.06,
      "text": "Nhưng lý do oái oăm nhất: phần lớn tàu vẫn phải ghé Singapore, để giao hàng, lấy nhiên liệu, sửa chữa.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/15.wav",
      "durationInSeconds": 6.087,
      "tempo": 1.1,
      "hash": "d89b0889e11a"
    },
    {
      "id": "16",
      "scene": "s7",
      "take": "t07",
      "gapAfter": 0.25,
      "text": "Lối tắt có đẹp mấy, cũng không bỏ được Singapore.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/16.wav",
      "durationInSeconds": 2.667,
      "tempo": 1.1,
      "hash": "d89b0889e11a"
    },
    {
      "id": "17",
      "scene": "s8",
      "take": "t08",
      "gapAfter": 0.06,
      "text": "Năm hai nghìn hai mươi ba, Thái Lan lại đưa ra phương án mới.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/17.wav",
      "durationInSeconds": 3.447,
      "tempo": 1.1,
      "hash": "608079dc907c"
    },
    {
      "id": "18",
      "scene": "s8",
      "take": "t08b",
      "gapAfter": 0.06,
      "text": "Không đào kênh, mà xây cầu đất liền: cảng, đường sắt và đường ống dầu.",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/18.wav",
      "durationInSeconds": 5.247,
      "tempo": 1.1,
      "hash": "c445c84d3279"
    },
    {
      "id": "19",
      "scene": "s8",
      "take": "t08b",
      "gapAfter": 0.25,
      "text": "Còn hiện tại,",
      "voice": "Orus",
      "src": "voiceover/p4-malacca-kra/19.wav",
      "durationInSeconds": 0.59,
      "tempo": 1.1,
      "hash": "c445c84d3279"
    }
  ]
}
